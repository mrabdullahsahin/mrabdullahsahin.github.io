---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

const projects = await getCollection('projects', ({ data }) => !data.draft)
const writing = await getCollection('writing', ({ data }) => !data.draft)

const sortedProjects = projects.sort((a, b) => a.data.order - b.data.order)

const recentWriting = writing
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3)

const statusColors: Record<string, string> = {
  live: 'var(--st-live)',
  acquired: 'var(--st-acquired)',
  'open-source': 'var(--st-live)',
  paused: 'var(--st-paused)',
  sunset: 'var(--st-sunset)',
  failed: 'var(--st-failed)',
}
---

<BaseLayout
  title="Abdullah Şahin"
  description="Software engineer. Side projects and writing about what they teach me."
  canonical="/"
>
  <main id="main">

    <section class="hero" data-screen-label="Hero" style="padding-top: 17vh;">
      <h1
        data-en="Software engineer. I build <em>side projects</em> and write about what they teach me."
        data-tr="Yazılım mühendisi. <em>Side project</em> üretir, bana öğrettiklerini yazarım."
      >
        Software engineer. I build <em>side projects</em> and write about what they teach me.
      </h1>
      <p
        class="sub"
        data-en="Some are alive, a few are gone. All of them are listed below — the honest version."
        data-tr="Bazıları yaşıyor, birkaçı yok artık. Hepsi aşağıda — dürüst hâliyle."
      >
        Some are alive, a few are gone. All of them are listed below — the honest version.
      </p>
      <div class="hero-links">
        <a href="mailto:hello@abdullahsahin.org">hello@abdullahsahin.org</a>
        <a href="https://github.com/mrabdullahsahin" rel="me">github</a>
        <a href="/writing" data-en="writing →" data-tr="yazılar →">writing →</a>
      </div>
    </section>

    <section id="projects" data-screen-label="Projects">
      <h2 class="sec-label" data-en="Projects" data-tr="Projeler">Projects</h2>
      <ul class="plist">
        {sortedProjects.map((project) => (
          <li>
            <a class="prow" href={`/projects/${project.id}`}>
              <span class="name">
                {project.data.name}
                <span class="yr">{project.data.years}</span>
              </span>
              <span class="status" style={`--c: ${statusColors[project.data.status]}`}>
                <span class="dot"></span>
                <span data-en={project.data.statusLabel} data-tr={project.data.statusLabelTr}>
                  {project.data.statusLabel}
                </span>
              </span>
              <span
                class="desc"
                data-en={project.data.description}
                data-tr={project.data.descriptionTr}
              >
                {project.data.description}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section id="writing" data-screen-label="Writing">
      <h2 class="sec-label" data-en="Writing" data-tr="Yazılar">Writing</h2>
      <ul class="wlist">
        {recentWriting.map((post) => {
          const [year, month] = post.data.date.split('-')
          return (
            <li>
              <a class="wrow" href={`/writing/${post.id}`}>
                <span class="t" data-en={post.data.title} data-tr={post.data.titleTr}>
                  {post.data.title}
                </span>
                <span class="d">{year}·{month}</span>
              </a>
            </li>
          )
        })}
      </ul>
      <a class="more-link" href="/writing" data-en="all writing →" data-tr="tüm yazılar →">
        all writing →
      </a>
    </section>

  </main>
</BaseLayout>
